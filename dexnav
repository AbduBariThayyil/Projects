#!/usr/bin/env python3
"""
DexNav Quick-Find [R] Configurator & CLI Tool for Pokémon Quetzal
Directly configures the in-game cartridge battery save (.sav) and emulator save states (.ss*).
Updates VAR_0x40F7 (0x3C2) and VAR_0x40F9 (0x3C6) in SaveBlock1 with valid sector checksum recalculation.
"""

import sys
import os
import zlib
import struct
import binascii
import sqlite3
import shutil
import subprocess

GBA_DIR = "/home/vibecoder/Games/Console Games/GBA"
DB_PATH = "/home/vibecoder/Projects/quetzal_database.db"
SECTOR_SIZE = 4096
SIGNATURE = 0x08012025


def calc_sector_checksum(sector_bytes: bytes) -> int:
    """Calculate 16-bit checksum of 0xFF4 bytes in a save sector."""
    s = sum(int.from_bytes(sector_bytes[i:i+4], "little") for i in range(0, 0xFF4, 4)) & 0xFFFFFFFF
    return ((s >> 16) + (s & 0xFFFF)) & 0xFFFF


def get_db_connection():
    if os.path.exists(DB_PATH):
        try:
            return sqlite3.connect(DB_PATH, timeout=5.0)
        except Exception:
            return None
    return None


def resolve_species(query: str):
    """Resolve an integer ID or species name to (species_id, name, national_dex_num, types)."""
    conn = get_db_connection()
    q = query.strip()
    
    # Try integer ID
    if q.isdigit():
        sp_id = int(q)
        if conn:
            cur = conn.cursor()
            cur.execute("SELECT id, name, national_dex_num, type1, type2 FROM pokemon WHERE id = ? OR national_dex_num = ? ORDER BY id ASC LIMIT 1", (sp_id, sp_id))
            row = cur.fetchone()
            if row:
                t = row[3] + (f"/{row[4]}" if row[4] else "")
                return row[0], row[1], row[2], t
        return sp_id, f"Species #{sp_id}", sp_id, "Unknown"

    # Try name query
    if conn:
        cur = conn.cursor()
        norm_q = q.replace("-", "%").replace(" ", "%").replace("_", "%")
        cur.execute("SELECT id, name, national_dex_num, type1, type2 FROM pokemon WHERE name LIKE ? ORDER BY id ASC LIMIT 1", (f"%{norm_q}%",))
        row = cur.fetchone()
        if row:
            t = row[3] + (f"/{row[4]}" if row[4] else "")
            return row[0], row[1], row[2], t

    return None, None, None, None


def get_current_sav_target(sav_path: str):
    """Read registered species from in-game .sav file."""
    if not os.path.exists(sav_path):
        return None
    try:
        with open(sav_path, "rb") as f:
            data = f.read()
        for sec_idx in range(len(data) // SECTOR_SIZE):
            sec = data[sec_idx * SECTOR_SIZE : (sec_idx + 1) * SECTOR_SIZE]
            sid = int.from_bytes(sec[0xFF4:0xFF6], "little")
            sig = int.from_bytes(sec[0xFF8:0xFFC], "little")
            if sid == 1 and sig == SIGNATURE:
                v = int.from_bytes(sec[0x3C6:0x3C8], "little")
                if v > 0:
                    return v
                v2 = int.from_bytes(sec[0x3C2:0x3C4], "little") & 0x3FFF
                if v2 > 0:
                    return v2
    except Exception:
        pass
    return None


def patch_sav_file(sav_path: str, species_id: int) -> bool:
    """Patch the in-game .sav battery save file with checksum recalculation."""
    if not os.path.exists(sav_path):
        return False

    backup_path = sav_path + ".bak"
    shutil.copy2(sav_path, backup_path)

    with open(sav_path, "rb") as f:
        data = bytearray(f.read())

    patched_any = False
    sp_bytes = struct.pack("<H", species_id)

    # Patch Sector ID 1 (SaveBlock1) across all save slots (both Slot 0 and Slot 1)
    for sec_idx in range(len(data) // SECTOR_SIZE):
        sec_start = sec_idx * SECTOR_SIZE
        sec_end = sec_start + SECTOR_SIZE
        sec = data[sec_start:sec_end]
        sid = int.from_bytes(sec[0xFF4:0xFF6], "little")
        sig = int.from_bytes(sec[0xFF8:0xFFC], "little")

        if sid == 1 and sig == SIGNATURE:
            # Write VAR_0x40F7 (species + land habitat 0) and VAR_0x40F9 (species)
            data[sec_start + 0x3C2 : sec_start + 0x3C4] = sp_bytes
            data[sec_start + 0x3C6 : sec_start + 0x3C8] = sp_bytes

            # Recalculate 16-bit checksum
            mod_sec = data[sec_start:sec_end]
            new_chk = calc_sector_checksum(mod_sec)
            data[sec_start + 0xFF6 : sec_start + 0xFF8] = struct.pack("<H", new_chk)
            patched_any = True

    if patched_any:
        with open(sav_path, "wb") as f:
            f.write(data)
        return True
    return False


def patch_savestate(state_path: str, species_id: int) -> bool:
    """Patch mGBA savestate (.ss*) if it exists."""
    if not os.path.exists(state_path):
        return False

    backup_path = state_path + ".bak"
    shutil.copy2(state_path, backup_path)

    with open(state_path, "rb") as f:
        data = bytearray(f.read())

    idx = 8
    patched = False
    new_data = bytearray(data[:8])
    sp_bytes = struct.pack("<H", species_id)

    while idx < len(data):
        length = int.from_bytes(data[idx:idx+4], "big")
        chunk_type = data[idx+4:idx+8]
        chunk_data = data[idx+8:idx+8+length]

        if chunk_type == b"gbAs":
            try:
                gbas = bytearray(zlib.decompress(chunk_data))
                # Patch offsets
                for off in [0x1ff82, 0x5c8c8]:
                    if off + 2 <= len(gbas):
                        gbas[off:off+2] = sp_bytes

                comp = zlib.compress(gbas)
                new_len = len(comp)
                new_crc = binascii.crc32(b"gbAs" + comp)

                new_data.extend(struct.pack(">I", new_len))
                new_data.extend(b"gbAs")
                new_data.extend(comp)
                new_data.extend(struct.pack(">I", new_crc))
                patched = True
            except Exception:
                new_data.extend(data[idx:idx+12+length])
        else:
            new_data.extend(data[idx:idx+12+length])

        idx += 12 + length

    if patched:
        with open(state_path, "wb") as f:
            f.write(new_data)
        return True
    return False


def notify(title: str, msg: str):
    """Send native desktop notification."""
    try:
        subprocess.run(["notify-send", title, msg], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def show_status():
    """Print current status of DexNav target in .sav and save states."""
    print("==================================================")
    print("        📡 DEXNAV QUICK-FIND [R] STATUS")
    print("==================================================")
    
    # 1. In-game .sav file
    for sav_name in ["Moemon Quetzal.sav", "Quetzal.sav"]:
        p = os.path.join(GBA_DIR, sav_name)
        real_p = os.path.realpath(p)
        if os.path.exists(real_p):
            tgt = get_current_sav_target(real_p)
            if tgt:
                _, name, nat, t = resolve_species(str(tgt))
                print(f" 💾 In-Game Save (.sav): #{tgt:04d} {name} [{t}] (Nat #{nat})")
            else:
                print(f" 💾 In-Game Save (.sav): Found ({os.path.basename(real_p)})")
            break

    # 2. Emulator states
    found_states = False
    for slot in range(10):
        for prefix in ["Quetzal", "Moemon Quetzal"]:
            sf = os.path.join(GBA_DIR, f"{prefix}.ss{slot}")
            if os.path.exists(sf):
                found_states = True
                print(f" 🕹️  Emulator State Slot {slot}: {os.path.basename(sf)}")
                break
    if not found_states:
        print(" 🕹️  No emulator save states found.")
    print("==================================================")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: dexnav <id_or_name> | status | list <search>")
        print("Examples:")
        print("  dexnav 250        # Set DexNav quick-find [R] to #250 Ho-Oh")
        print("  dexnav 001        # Set DexNav quick-find [R] to #001 Bulbasaur")
        print("  dexnav ralts      # Set DexNav quick-find [R] to Ralts")
        print("  dexnav status     # View current DexNav [R] species in .sav and save states")
        print("  dexnav list fire  # Search species database")
        return 0

    cmd = sys.argv[1].lower()

    if cmd == "status":
        show_status()
        return 0

    if cmd == "list":
        query = sys.argv[2] if len(sys.argv) > 2 else ""
        conn = get_db_connection()
        if not conn:
            print("Database not available.")
            return 1
        cur = conn.cursor()
        cur.execute("SELECT id, name, national_dex_num, type1, type2 FROM pokemon WHERE name LIKE ? OR type1 LIKE ? OR type2 LIKE ? LIMIT 20", (f"%{query}%", f"%{query}%", f"%{query}%"))
        rows = cur.fetchall()
        print(f"Found {len(rows)} matching Pokémon:")
        for r in rows:
            t = r[3] + (f"/{r[4]}" if r[4] else "")
            print(f"  #{r[0]:04d} (Nat #{r[2]}): {r[1]:<16} [{t}]")
        return 0

    # Resolve target
    sp_id, name, nat, types = resolve_species(sys.argv[1])
    if sp_id is None or sp_id <= 0:
        print(f"❌ Error: Could not resolve Pokémon '{sys.argv[1]}'.", file=sys.stderr)
        print("Tip: Use 'dexnav list <name>' to find valid species names and IDs.", file=sys.stderr)
        return 1

    print("==================================================")
    print(f" 🎯 Setting DexNav [R] Quick-Find to: #{sp_id:04d} {name}")
    print(f"    Type: {types}  |  National Dex: #{nat}")
    print("==================================================")

    # 1. Patch In-Game Game Save File (.sav)
    patched_sav = False
    for sav_name in ["Moemon Quetzal.sav", "Quetzal.sav"]:
        p = os.path.join(GBA_DIR, sav_name)
        real_p = os.path.realpath(p)
        if os.path.exists(real_p):
            if patch_sav_file(real_p, sp_id):
                print(f" ✓ Patched In-Game Battery Save (.sav): {os.path.basename(real_p)}")
                patched_sav = True
                break

    # 2. Patch Emulator Save States (.ss*)
    patched_states = 0
    for slot in range(10):
        for prefix in ["Quetzal", "Moemon Quetzal"]:
            sf = os.path.join(GBA_DIR, f"{prefix}.ss{slot}")
            if os.path.exists(sf):
                if patch_savestate(sf, sp_id):
                    patched_states += 1
                break

    if patched_sav or patched_states > 0:
        print("--------------------------------------------------")
        print(f" ✨ SUCCESS: DexNav Quick-Find set to #{sp_id:04d} {name}!")
        if patched_sav:
            print(" 💾 In-Game Save (.sav): Updated with valid checksum!")
            print("    -> In mGBA, reload in-game save via 'File -> Reset' (Ctrl+R) or soft-reset (A+B+Start+Select) to load the updated .sav file.")
        if patched_states > 0:
            print(f" 🕹️  Emulator Quick-Saves (.ss*): {patched_states} slots synchronized.")
        print("==================================================")
        notify("DexNav [R] Target Updated", f"Set to #{sp_id:04d} {name} ({types}) in .sav file!")
        return 0
    else:
        print("❌ Error: Could not find any .sav or .ss save files in GBA directory.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
