#!/usr/bin/env python3
"""qt-music - Fast CLI entrypoint and lazy launcher for headless daemon & on-demand QML UI."""
from __future__ import annotations

import argparse
import os
import signal
import socket
import sys
import time
from pathlib import Path

def _ipc_send(ipc_names, cmd, wait_ack=True):
    """Pure stdlib AF_UNIX client (no Qt/GLib imports -> ~15ms execution)."""
    for s_name in ipc_names:
        sp = "/tmp/" + s_name
        if not os.path.exists(sp):
            continue
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(0.4)
        try:
            sock.connect(sp)
            sock.sendall((cmd + "\n").encode())
            if wait_ack:
                try:
                    sock.recv(64)
                except Exception:
                    pass
            return True
        except OSError:
            try:
                os.unlink(sp)
            except OSError:
                pass
        finally:
            try:
                sock.close()
            except Exception:
                pass
    return False


def _ensure_daemon_stopped(uid, ipc_names):
    """Guarantee qt-music daemon exits when --quit is invoked (even if mid-network call)."""
    pid_path = f"/tmp/qt-music-{uid}.pid"
    pid = None
    try:
        pid = int(Path(pid_path).read_text().strip())
    except Exception:
        pid = None
    sent = _ipc_send(ipc_names, "quit", wait_ack=True)
    if pid:
        deadline = time.monotonic() + 1.0
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                pid = None
                break
            except PermissionError:
                break
            time.sleep(0.03)
        if pid is not None:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    break
                time.sleep(0.15)
    for sp in ["/tmp/" + n for n in ipc_names] + [pid_path]:
        try:
            os.unlink(sp)
        except FileNotFoundError:
            pass
    return sent or pid is not None


def main_qt():
    ap = argparse.ArgumentParser(prog="qt-music", description="Native fullscreen word-by-word lyrics for your music.")
    ap.add_argument("-p", "--player", help=argparse.SUPPRESS)
    ap.add_argument("--own", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--follow", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--mpris-name", default="qt-music", metavar="NAME",
                    help="name other programs (polybar, playerctl) see while playing your library, e.g. qt-music")
    ap.add_argument("--music", metavar="DIR", help="music folder (default ~/Music or $MUSICD_DIR)")
    ap.add_argument("--controls", action="store_true", help="show the prev/play/next buttons from the start")
    ap.add_argument("--windowed", action="store_true", help="don't start fullscreen")
    ap.add_argument("--tray", action="store_true", help="start headlessly without opening GUI")
    ap.add_argument("--gui-proc", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--toggle", action="store_true", help="toggle existing qt-music window visibility via IPC")
    ap.add_argument("--toggle-existing", action="store_true", help="toggle existing daemon GUI only; exit 1 if daemon not running")
    ap.add_argument("--show", action="store_true", help="show existing qt-music window via IPC")
    ap.add_argument("--hide", action="store_true", help="hide existing qt-music window via IPC")
    ap.add_argument("--quit", action="store_true", help="quit running qt-music daemon")
    ap.add_argument("--lite", action="store_true", help="no drifting background or card mask (for weak GPUs)")
    ap.add_argument("--font", help="lyrics font family (default: your system font)")
    ap.add_argument("--screenshot", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--size", metavar="WxH", help=argparse.SUPPRESS)
    ap.add_argument("--keys", metavar="LIST", help=argparse.SUPPRESS)
    ap.add_argument("--track", type=int, help=argparse.SUPPRESS)
    ap.add_argument("--seek", type=float, help=argparse.SUPPRESS)
    a = ap.parse_args()
    signal.signal(signal.SIGINT, signal.SIG_DFL)

    uid = os.getuid()
    ipc_names = [f"qt-music-ipc-{uid}", f"lyricview-ipc-{uid}"]
    primary_ipc = ipc_names[0]

    pkg_dir = str(Path(__file__).resolve().parent)
    if pkg_dir not in sys.path:
        sys.path.insert(0, pkg_dir)

    if a.gui_proc:
        from qm_gui import main_gui_proc
        main_gui_proc(a, primary_ipc)
        return

    if a.quit:
        _ensure_daemon_stopped(uid, ipc_names)
        sys.exit(0)

    if a.toggle_existing:
        sys.exit(0 if _ipc_send(ipc_names, "toggle") else 1)

    if not a.screenshot and not a.keys and not a.track:
        cmd = "toggle" if a.toggle else ("hide" if a.hide else "show")
        if _ipc_send(ipc_names, cmd):
            sys.exit(0)

    if a.hide:
        sys.exit(0)

    from qm_daemon import main_daemon
    main_daemon(a, ipc_names)


if __name__ == "__main__":
    if len(sys.argv) == 2:
        flag = sys.argv[1]
        uid = os.getuid()
        ipc_names = [f"qt-music-ipc-{uid}", f"lyricview-ipc-{uid}"]
        if flag == "--quit":
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            _ensure_daemon_stopped(uid, ipc_names)
            sys.exit(0)
        elif flag == "--toggle-existing":
            sys.exit(0 if _ipc_send(ipc_names, "toggle") else 1)
        elif flag == "--hide":
            _ipc_send(ipc_names, "hide")
            sys.exit(0)
        elif flag in ("--toggle", "--show"):
            if _ipc_send(ipc_names, flag[2:]):
                sys.exit(0)
    main_qt()
