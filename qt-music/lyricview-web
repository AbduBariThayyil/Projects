const fmt=s=>{s=Math.max(0,Math.floor(s));return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};
const now=()=>B.playing?B.pos+(performance.now()-B.t)/1000:B.pos;
const post=(p)=>fetch(p,{method:'POST'}).catch(()=>{});

/* ---------- palette from artwork ---------- */
function palette(img){
  try{
    const c=document.createElement('canvas');c.width=c.height=24;
    const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0,24,24);
    const d=x.getImageData(0,0,24,24).data,bk=Array.from({length:12},()=>({w:0,r:0,g:0,b:0}));
    for(let i=0;i<d.length;i+=4){
      const r=d[i],g=d[i+1],b=d[i+2],mx=Math.max(r,g,b),mn=Math.min(r,g,b),s=mx?(mx-mn)/mx:0,v=mx/255;
      if(v<.2)continue;
      let h=0;if(mx!==mn){const dd=mx-mn;h=mx===r?((g-b)/dd)%6:mx===g?(b-r)/dd+2:(r-g)/dd+4;h=(h*60+360)%360}
      const w=s*s*v+.01,o=bk[Math.floor(h/30)%12];o.w+=w;o.r+=r*w;o.g+=g*w;o.b+=b*w;
    }
    bk.sort((a,b)=>b.w-a.w);
    const lift=o=>{let c=[o.r/o.w,o.g/o.w,o.b/o.w];const m=Math.max(...c);if(m<150)c=c.map(v=>v*150/Math.max(m,1));return c.map(Math.round).join(',')};
    if(bk[0].w>0){
      document.documentElement.style.setProperty('--c1',lift(bk[0]));
      document.documentElement.style.setProperty('--c2',bk[1].w>bk[0].w*.25?lift(bk[1]):lift(bk[0]).split(',').reverse().join(','));
    }
  }catch(e){}
}
function setBackground(url){
  const a=bgFlip?$('#bgA'):$('#bgB'),b=bgFlip?$('#bgB'):$('#bgA');bgFlip=!bgFlip;
  a.style.backgroundImage=`url(${url})`;a.classList.add('show');b.classList.remove('show');
}

/* ---------- track + lyrics ---------- */
function newTrack(s){
  key=s.key;
  el.title.textContent=s.title||'Unknown title';el.artist.textContent=s.artist;el.album.textContent=s.album;
  el.tend.textContent=fmt(s.length);
  document.title=`${s.artist} – ${s.title}`;
  el.ly.classList.add('swap');
  const url='/art?k='+key;el.cover.classList.remove('ok');
  el.cover.onload=()=>{el.cover.classList.add('ok');palette(el.cover);setBackground(url)};
  el.cover.onerror=()=>{el.cover.classList.remove('ok')};
  el.cover.src=url;
  const k=key;
  fetch('/lyrics?k='+k).then(r=>r.json()).then(d=>{if(k===key){L=d;render()}}).catch(()=>{});
}
function render(){
  el.ly.innerHTML='';lines=[];cur=-2;lastPos=-1;
  document.body.classList.toggle('nolyrics',L.kind==='none');
  el.stage.classList.toggle('plain',L.kind==='plain');
  el.msg.textContent=L.kind==='none'?'No lyrics found for this track':'';
  L.lines.forEach(ln=>{
    const d=document.createElement('div');d.className='line'+(ln.gap?' gap':'');
    if(ln.gap){d._dots=[0,1,2].map(()=>{const s=document.createElement('span');s.className='dot';d.appendChild(s);return s})}
    else if(L.kind==='synced'){
      d._ws=ln.words.map(w=>{const s=document.createElement('span');s.className='w';s.textContent=w.w+(w.s?' ':'');d.appendChild(s);s._f=0;return s});
      d.onclick=()=>seekTo(ln.t);
    }else d.textContent=ln.text||'\u00a0';
    d._st='future';el.ly.appendChild(d);lines.push(d);
  });
  requestAnimationFrame(()=>{measure();el.ly.classList.remove('swap');setActive(L.kind==='synced'?-1:-1,true);ensureLoop()});
}
function measure(){
  tops=lines.map(e=>e.offsetTop+e.offsetHeight/2);totalH=el.ly.offsetHeight;
}
function setWords(e,f){(e._ws||[]).forEach(s=>{s._f=f;s.style.setProperty('--p',f);s.classList.remove('cur')})}
function setActive(i,force){
  if(L.kind!=='synced'){return}
  lines.forEach((e,j)=>{
    const d=j-i,st=d<0?'past':d===0?'on':'future';
    e.classList.toggle('on',d===0);e.classList.toggle('past',d<0);
    e.style.setProperty('--bl',d===0||e.classList.contains('gap')?'0px':(Math.min(Math.abs(d),6)*.75)+'px');
    e.style.setProperty('--d',d>0?Math.min(d,6)*45+'ms':'0ms');
    if(e._st!==st||force){if(e._ws){if(st==='past')setWords(e,1);else if(st==='future')setWords(e,0)}
      if(e._dots&&st!=='on')e._dots.forEach(x=>{x.style.opacity=.25;x.style.transform='scale(.8)'});e._st=st}
  });
  cur=i;
  const y=el.stage.clientHeight*.36-(tops[Math.max(i,0)]||0);
  el.ly.style.transform=`translateY(${y}px)`;
}
function activeIdx(p){
  let lo=0,hi=L.lines.length-1,r=-1;
  while(lo<=hi){const m=(lo+hi)>>1;if(L.lines[m].t<=p){r=m;lo=m+1}else hi=m-1}
  return r;
}
function animate(i,p){
  const ln=L.lines[i],e=lines[i];if(!ln||!e)return;
  if(ln.gap){
    const f=clamp((p-ln.t)/Math.max(ln.e-ln.t,.1),0,1);
    e._dots.forEach((x,k)=>{const q=clamp(f*3-k,0,1),br=1+.12*Math.sin(p*3+k);x.style.opacity=.25+.75*q;x.style.transform=`scale(${(.8+.3*q)*br})`});
    return;
  }
  let curSet=false;
  ln.words.forEach((w,k)=>{
    const f=p>=w.e?1:p<=w.t?0:(p-w.t)/(w.e-w.t),s=e._ws[k];
    if(Math.abs(f-s._f)>.004||f!==s._f&&(f===0||f===1)){s._f=f;s.style.setProperty('--p',f)}
    const isCur=f>0&&f<1&&!curSet;if(isCur)curSet=true;s.classList.toggle('cur',isCur);
  });
}
function tick(){
  raf=0;
  const raw=now(),p=raw+off;
  if(B.len>0){el.fill.style.width=(clamp(raw/B.len,0,1)*100)+'%';
    const t=fmt(raw);if(el.tcur.textContent!==t)el.tcur.textContent=t}
  if(L.kind==='synced'&&lines.length){
    const i=activeIdx(p);if(i!==cur)setActive(i);
    if(i>=0)animate(i,p);
  }else if(L.kind==='plain'&&B.len>0){
    const y=el.stage.clientHeight*.22-clamp(raw/B.len,0,1)*Math.max(0,totalH-el.stage.clientHeight*.55);
    el.ly.style.transform=`translateY(${y}px)`;
  }
  if(B.playing)raf=requestAnimationFrame(tick);
}
function ensureLoop(){if(!raf)raf=requestAnimationFrame(tick)}

/* ---------- polling ---------- */
async function poll(){
  try{
    const s=await (await fetch('/state',{cache:'no-store'})).json();
    document.body.classList.toggle('empty',!s.active);
    if(s.active){
      const playing=s.status==='Playing',changed=s.key!==key;
      if(changed)newTrack(s);
      if(changed||playing!==B.playing||Math.abs(now()-s.pos)>.3)B={pos:s.pos,t:performance.now(),playing,len:s.length};
      B.len=s.length;
      document.body.classList.toggle('paused',!playing);
      ensureLoop();
    }
  }catch(e){}
  setTimeout(poll,500);
}
function seekTo(t){B={...B,pos:Math.max(0,t),t:performance.now()};post('/ctl/seek?pos='+Math.max(0,t));ensureLoop()}

/* ---------- input ---------- */
$('#pp').onclick=()=>post('/ctl/playpause');$('#next').onclick=()=>post('/ctl/next');$('#prev').onclick=()=>post('/ctl/previous');
addEventListener('keydown',e=>{
  if(e.key===' '){e.preventDefault();post('/ctl/playpause')}
  else if(e.key==='ArrowRight')seekTo(now()+5);else if(e.key==='ArrowLeft')seekTo(now()-5);
  else if(e.key==='n'||e.key==='N')post('/ctl/next');else if(e.key==='p'||e.key==='P')post('/ctl/previous');
  else if(e.key==='f'||e.key==='F'){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen().catch(()=>{})}
  else if(e.key==='['||e.key===']'){off+=(e.key==='['?-.1:.1);localStorage.setItem('lv_off',off.toFixed(2));
    $('#hint').textContent=`lyric timing ${off>=0?'+':''}${off.toFixed(1)}s`;$('#hint').classList.add('show');setTimeout(()=>$('#hint').classList.remove('show'),1500);ensureLoop()}
});
let idleT;const wake=()=>{document.body.classList.remove('idle');clearTimeout(idleT);idleT=setTimeout(()=>document.body.classList.add('idle'),3000)};
addEventListener('mousemove',wake);addEventListener('keydown',wake);
addEventListener('resize',()=>{measure();if(L.kind==='synced')setActive(cur,true);ensureLoop()});
setTimeout(()=>{$('#hint').classList.add('show');setTimeout(()=>$('#hint').classList.remove('show'),5000)},1200);
poll();
})();
</script></body></html>
