<script>
(()=>{
const $=s=>document.querySelector(s);
const el={title:$('#title'),artist:$('#artist'),album:$('#album'),cover:$('#cover'),fill:$('#fill'),tcur:$('#tcur'),tend:$('#tend'),
  ly:$('#lyrics'),stage:$('#stage'),msg:$('#msg')};
let key='',L={kind:'none',lines:[]},lines=[],tops=[],cur=-2,raf=0,lastPos=-1,bgFlip=false,totalH=0;
