#!/usr/bin/env bash
# PolybarMusic - centre playback module for polybar (LyricView / Lollypop / Spotify / MPD via playerctl)
#
# Click map:  face + title, and time + bar  -> LyricViewLauncher
#             play/pause, prev, next icons  -> playerctl

LAUNCH="LyricViewLauncher"
TITLE_W=16     # title column width, in characters
BAR_W=8        # progress bar length, in characters
WIDTH=54       # visible width of the playing layout; "No Music" is padded to match it
               # (keeps the centred block, and so the date, from jumping when playback starts/stops)

# Everything below counts characters, not bytes. Polybar may start us with no UTF-8 locale.
[[ "${LC_ALL:-${LANG:-}}" == *[Uu][Tt][Ff]* ]] || export LC_ALL=C.UTF-8

FACES=("(•‿•)" "(^‿^)" "(¬‿¬)" "(◕‿◕)" "(o_o)" "(°‿°)")

no_music() {
    local txt="(•‿•) No Music" fill=""
    (( WIDTH > ${#txt} )) && printf -v fill '%*s' $(( WIDTH - ${#txt} )) ''
    echo "%{O45}%{A1:$LAUNCH:}%{F#4c566a}${txt}%{F-}%{A}${fill}"
}

# One playerctl call (= one D-Bus client) covers every player: name|status|position(us)|length(us)|title
# Title goes last so a '|' inside it cannot shift the other fields.
# Pick the player that is Playing; otherwise the first Paused one.
PLAYER="" STATUS="" POS=0 LEN=0 TITLE=""
while IFS='|' read -r name status pos len title; do
    [[ ${name,,} =~ qt-music|lyricview|lollypop|spotify|mpd ]] || continue
    case $status in
        Playing) PLAYER=$name STATUS=$status POS=$pos LEN=$len TITLE=$title; break ;;
        Paused)  [[ -z $PLAYER ]] && { PLAYER=$name STATUS=$status POS=$pos LEN=$len TITLE=$title; } ;;
    esac
done < <(playerctl -a metadata --format '{{playerName}}|{{status}}|{{position}}|{{mpris:length}}|{{title}}' 2>/dev/null)

[[ -z $PLAYER ]] && { no_music; exit 0; }

# Title: strip "%{" (polybar would read it as a formatting tag), cut and pad by characters
[[ -z $TITLE ]] && TITLE="Unknown"
tag='%{'; TITLE=${TITLE//"$tag"/}
(( ${#TITLE} > TITLE_W )) && TITLE="${TITLE:0:TITLE_W-1}…"
printf -v TITLE_FIXED '%s%*s' "$TITLE" $(( TITLE_W - ${#TITLE} )) ''

# Time + progress bar
[[ $POS =~ ^[0-9]+$ ]] || POS=0
[[ $LEN =~ ^[0-9]+$ ]] || LEN=0
POS=$(( 10#$POS / 1000000 )); TOTAL=$(( 10#$LEN / 1000000 ))
FILLED=0; TIME_STR=" 0:00/ 0:00"
if (( TOTAL > 0 )); then
    printf -v TIME_STR '%2d:%02d/%2d:%02d' $((POS/60)) $((POS%60)) $((TOTAL/60)) $((TOTAL%60))
    FILLED=$(( POS * BAR_W / TOTAL ))
    (( FILLED > BAR_W )) && FILLED=$BAR_W
fi
BAR=""
for (( i = 0; i < BAR_W; i++ )); do
    if (( i < FILLED )); then BAR+="━"; else BAR+="─"; fi
done

# Face animates once a second while playing
if [[ $STATUS == Playing ]]; then
    FACE=${FACES[EPOCHSECONDS % ${#FACES[@]}]}
    PLAY_ICON="󰏤"
else
    FACE="(•‿•)"
    PLAY_ICON="󰐊"
fi

CLOSE_CMD="qt-music --quit 2>/dev/null; playerctl -p $PLAYER stop 2>/dev/null; playerctl -p $PLAYER quit 2>/dev/null"
CLOSE_BTN="%{F#ff5555}%{A1:$CLOSE_CMD:}󰅖%{A}%{F-}"

echo "%{O45}%{A1:$LAUNCH:}%{F#bd93f9}${FACE}%{F-}  %{F#f8f8f2}${TITLE_FIXED}%{F-}%{A}  %{F#50fa7b}%{A1:playerctl -p $PLAYER play-pause:}${PLAY_ICON}%{A}%{F-} %{F#8be9fd}%{A1:playerctl -p $PLAYER previous:}󰒮%{A}%{F-} %{A1:$LAUNCH:}%{F#bd93f9}${TIME_STR}%{F-} %{F#ff79c6}${BAR}%{F-}%{A} %{F#8be9fd}%{A1:playerctl -p $PLAYER next:}󰒭%{A}%{F-}  ${CLOSE_BTN}"
