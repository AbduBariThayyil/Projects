def main_qt():
    ap = argparse.ArgumentParser(prog="lyricview", description="Native fullscreen word-by-word lyrics for your MPRIS player.")
    ap.add_argument("-p", "--player", help="only follow this player (e.g. lollypop, mpv, spotify)")
    ap.add_argument("--own", action="store_true", help="start in your-own-library mode even if another player is running")
    ap.add_argument("--follow", action="store_true", help="start by following other players")
    ap.add_argument("--mpris-name", default="lollypop", metavar="NAME",
                    help="name other programs (polybar, playerctl) see while playing your library, e.g. Lollypop")
    ap.add_argument("--music", metavar="DIR", help="music folder (default ~/Music or $MUSICD_DIR)")
    ap.add_argument("--controls", action="store_true", help="show the prev/play/next buttons from the start")
    ap.add_argument("--windowed", action="store_true", help="don't start fullscreen")
    ap.add_argument("--lite", action="store_true", help="no drifting background or card mask (for weak GPUs)")
    ap.add_argument("--font", help="lyrics font family (default: your system font)")
    ap.add_argument("--screenshot", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--size", metavar="WxH", help=argparse.SUPPRESS)
    ap.add_argument("--keys", metavar="LIST", help=argparse.SUPPRESS)
    a = ap.parse_args()
    if not shutil.which("playerctl"):
        sys.exit("playerctl not found - install it: sudo pacman -S playerctl")
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    if a.mpris_name != "lyricview":
        IGNORE.clear()  # we may be pretending to be Lollypop: never hide the real one from ourselves
    prune_art()
    app = QGuiApplication(sys.argv)
    app.setApplicationName("lyricview")
    bridge = Bridge(State(a.player), a)
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("bridge", bridge)
    engine.loadData(QML.encode("utf-8"), QUrl("file:///lyricview.qml"))
    if not engine.rootObjects():
        sys.exit("could not load the UI - is Qt Quick complete? (sudo pacman -S pyside6 qt6-declarative)")
    bridge.start()
    app.aboutToQuit.connect(bridge._kill_follow)
    win = engine.rootObjects()[0]
    try:
        win.sceneGraphError.connect(lambda err, msg: print(f"lyricview: sceneGraphError {err}: {msg}", file=sys.stderr))
    except Exception:
        pass
    if a.size:
        win.resize(*[int(v) for v in a.size.lower().split("x")])
    steps = [s for s in (a.keys or "").split(",") if s]
    if steps:  # test hook: replay key presses, e.g. --keys Tab,Down,Return
        from PySide6.QtTest import QTest

        def press(i=0):
            if i >= len(steps):
                return
            mods, name = Qt.KeyboardModifier.NoModifier, steps[i]
            while "+" in name[1:]:
                m, name = name.split("+", 1)
                mods |= {"Shift": Qt.KeyboardModifier.ShiftModifier, "Ctrl": Qt.KeyboardModifier.ControlModifier}[m]
            if name.startswith("wait"):
                QTimer.singleShot(int(name[4:] or 500), lambda: press(i + 1))
                return
            if len(name) == 1:
                QTest.keyClick(win, name, mods)
            else:
                QTest.keyClick(win, getattr(Qt.Key, "Key_" + name), mods)
            QTimer.singleShot(350, lambda: press(i + 1))
        QTimer.singleShot(2500, press)
    if a.screenshot:
        total = sum(int(s[4:] or 500) if s.startswith("wait") else 350 for s in steps)
        QTimer.singleShot(3500 + total, lambda: (win.grabWindow().save(a.screenshot), app.quit()))
    sys.exit(app.exec())


if __name__ == "__main__":
    main_qt()
