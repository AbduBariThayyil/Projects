def palette(tiny):
    """Two accent colours from a tiny thumbnail (saturation/brightness weighted hue buckets)."""
    bk = [[0.0, 0.0, 0.0, 0.0] for _ in range(12)]
    for y in range(tiny.height()):
        for x in range(tiny.width()):
            c = tiny.pixelColor(x, y)
            r, g, b = c.red(), c.green(), c.blue()
            mx, mn = max(r, g, b), min(r, g, b)
            v = mx / 255
            if v < 0.2:
                continue
            s = (mx - mn) / mx if mx else 0
            w = s * s * v + 0.01
            o = bk[(max(c.hsvHue(), 0) // 30) % 12]
            o[0] += w; o[1] += r * w; o[2] += g * w; o[3] += b * w
    bk.sort(key=lambda o: -o[0])
    if bk[0][0] <= 0:
        return "#6c5ce7", "#00b894"

    def lift(o):
        cs = [o[1] / o[0], o[2] / o[0], o[3] / o[0]]
        m = max(cs)
        if m < 150:
            cs = [v * 150 / max(m, 1) for v in cs]
        return "#%02x%02x%02x" % tuple(min(255, int(v)) for v in cs)
    c1 = lift(bk[0])
    return c1, (lift(bk[1]) if bk[1][0] > bk[0][0] * 0.25 else c1)


def make_card(img, S=600, pad=60):
    """Rounded cover with a soft shadow baked into a transparent PNG (S + 2*pad square)."""
    C, sm, ig = S + 2 * pad, Qt.TransformationMode.SmoothTransformation, Qt.AspectRatioMode.IgnoreAspectRatio
    f = 10.0
    small = QImage(int(C / f), int(C / f), QImage.Format.Format_ARGB32_Premultiplied)
    small.fill(Qt.GlobalColor.transparent)
    p = QPainter(small)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(0, 0, 0, 185))
    p.drawRoundedRect(QRectF(pad / f, pad / f + 3.4, S / f, S / f), S * 0.05 / f, S * 0.05 / f)
    p.end()
    out = QImage(C, C, QImage.Format.Format_ARGB32_Premultiplied)
    out.fill(Qt.GlobalColor.transparent)
    p = QPainter(out)
    p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
    p.drawImage(0, 0, small.scaled(C, C, ig, sm))
    path = QPainterPath()
    path.addRoundedRect(QRectF(pad, pad, S, S), S * 0.05, S * 0.05)
    p.setClipPath(path)
    p.drawImage(pad, pad, img.scaled(S, S, ig, sm))
    p.end()
    return out


def process_art(data, key):
    """Cover bytes -> square cover file, soft blurred background file, two accent colours."""
    img = QImage.fromData(data)
    if img.isNull():
        return None
    side = min(img.width(), img.height())
    sq = img.copy((img.width() - side) // 2, (img.height() - side) // 2, side, side)
    sm, ig = Qt.TransformationMode.SmoothTransformation, Qt.AspectRatioMode.IgnoreAspectRatio
    art = sq.scaled(720, 720, ig, sm) if side > 720 else sq
    tiny = sq.scaled(20, 20, ig, sm)
    bg = tiny.scaled(320, 320, ig, sm).scaled(40, 40, ig, sm).scaled(480, 480, ig, sm)  # cheap, GPU-free blur
    ART.mkdir(parents=True, exist_ok=True)
    pa, pb, pc, pm = ART / f"{key}.jpg", ART / f"{key}-bg.jpg", ART / f"{key}-card.png", ART / f"{key}-mid.jpg"
    art.save(str(pa), "JPG", 92)
    bg.save(str(pb), "JPG", 88)
    sq.scaled(112, 112, ig, sm).scaled(700, 700, ig, sm).save(str(pm), "JPG", 88)  # recognisable but soft: the "backdrop" cover
    make_card(sq).save(str(pc), "PNG")
    c1, c2 = palette(tiny)
    u = lambda p: QUrl.fromLocalFile(str(p)).toString()
    return {"art": u(pa), "bg": u(pb), "card": u(pc), "mid": u(pm), "c1": c1, "c2": c2}


def prune_art(keep=300):
    try:
        files = sorted(list(ART.glob("*.jpg")) + list(ART.glob("*.png")), key=lambda p: p.stat().st_mtime, reverse=True)
        for p in files[keep * 4:]:
            p.unlink(missing_ok=True)
    except OSError:
        pass


class Bridge(QObject):
