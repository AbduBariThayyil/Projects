    def _on_lyr(self, js):
        d = json.loads(js)
        self._kind, self._src, self._wordlevel = d["kind"], d.get("src", ""), bool(d.get("wordlevel"))
        self._raw, self._length = d.get("raw"), d.get("length") or 0.0
