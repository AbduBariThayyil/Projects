def resolve_stream(vid):
    """Direct audio URL for a video (yt-dlp, no download). Cached for a while - URLs stay valid for hours."""
    if _FAKE:
        return "http://fake.invalid/" + vid
    c = _STREAMS.get(vid)
    if c and time.time() - c[1] < 1200:
        return c[0]
    import yt_dlp
    opts = {"quiet": True, "no_warnings": True, "noplaylist": True, "skip_download": True, "logger": _NoLog(),
            "format": "bestaudio[ext=m4a]/bestaudio/best", "socket_timeout": 15}
    with yt_dlp.YoutubeDL(opts) as y:
        info = y.extract_info("https://www.youtube.com/watch?v=" + vid, download=False)
    url = info.get("url") or next((f["url"] for f in reversed(info.get("formats") or []) if f.get("url") and f.get("acodec") != "none"), "")
    if not url:
        raise RuntimeError("no audio stream")
    _STREAMS[vid] = (url, time.time())
    return url


# ───── playback engines (QtMultimedia for real, a timer-based stand-in for tests)
class QtEngine(QObject):
    ended, failed, stateChanged = Signal(), Signal(str), Signal(str)

    def __init__(self):
        super().__init__()
        from PySide6.QtMultimedia import QAudioOutput, QMediaPlayer
        self.M = QMediaPlayer
        self.p, self.out = QMediaPlayer(), QAudioOutput()
        self.p.setAudioOutput(self.out)
        self.p.mediaStatusChanged.connect(self._on_ms)

    def _on_ms(self, s):
        from PySide6.QtMultimedia import QMediaPlayer
        if s == QMediaPlayer.MediaStatus.EndOfMedia:
            pos = self.position()
            dur = self.p.duration() / 1000.0 if self.p.duration() > 0 else 0
            if dur > 0 and pos >= max(3.0, dur - 3.0):
                self.ended.emit()
            elif dur <= 0 and pos > 10.0:
                self.ended.emit()
        self.p.playbackStateChanged.connect(self._ps)
        self.p.errorOccurred.connect(lambda e, msg: self.failed.emit(msg or "playback error"))

    def _ps(self, st):
        names = {self.M.PlaybackState.PlayingState: "Playing", self.M.PlaybackState.PausedState: "Paused"}
        self.stateChanged.emit(names.get(st, "Stopped"))

    def load(self, path): self.p.setSource(QUrl.fromLocalFile(path))
    def load_url(self, url, length=0.0): self.p.setSource(QUrl(url))
    def play(self): self.p.play()
    def pause(self): self.p.pause()
    def position(self): return self.p.position() / 1000.0
    def seek(self, sec): self.p.setPosition(int(max(0, sec) * 1000))
    def set_volume(self, v): self.out.setVolume(max(0.0, min(1.0, v)))


class NullEngine(QObject):
    """No audio: advances a clock in real time (LYRICVIEW_ENGINE=null, used by the tests)."""
    ended, failed, stateChanged = Signal(), Signal(str), Signal(str)

    def __init__(self):
        super().__init__()
        self.state, self.base, self.t0, self.dur = "Stopped", 0.0, time.time(), 0.0
        self.speed = float(os.environ.get("LYRICVIEW_NULL_SPEED", "1"))
        self.tm = QTimer(self)
        self.tm.setInterval(50)
        self.tm.timeout.connect(self._tick)
        self.tm.start()

    def _tick(self):
        if self.state == "Playing" and self.dur and self.position() >= self.dur:
            self.state = "Stopped"
            self.base = self.dur
            self.stateChanged.emit("Stopped")
            self.ended.emit()

    def load(self, path):
        self.base, self.t0, self.state = 0.0, time.time(), "Stopped"
        self.dur = next((t["len"] for t in getattr(self, "tracks", []) if t["path"] == path), 0) or 30.0
        if os.environ.get("LYRICVIEW_FAIL_FIRST") and "/fixed/" not in path and path not in self.__dict__.setdefault("_bad", set()):
            self._bad.add(path)
            self.dur = 30.0
            QTimer.singleShot(60, lambda: self.failed.emit("Demuxing failed"))

    def load_url(self, url, length=0.0):
        self.base, self.t0, self.state, self.dur = 0.0, time.time(), "Stopped", length or 30.0

    def play(self): self.t0, self.state = time.time(), "Playing"; self.stateChanged.emit("Playing")
    def pause(self): self.base, self.state = self.position(), "Paused"; self.stateChanged.emit("Paused")
    def position(self): return self.base + ((time.time() - self.t0) * self.speed if self.state == "Playing" else 0)
    def seek(self, sec): self.base, self.t0 = max(0.0, sec), time.time()
    def set_volume(self, v): pass


