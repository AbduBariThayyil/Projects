    def _kill_follow(self):
        p, self._fproc = self._fproc, None
        if p and p.poll() is None:
            p.terminate()

    def _follow(self):
        """playerctl --follow prints a line on every track/status change. Runs only in follow mode and can't outlive us."""
        def die_with_parent():
            try:
                import ctypes
                ctypes.CDLL("libc.so.6").prctl(1, 15)  # PR_SET_PDEATHSIG, SIGTERM
            except Exception:
                pass
        while True:
            if self._mode != "follow":
                time.sleep(0.5)
                continue
            try:
                self._fproc = subprocess.Popen(self.st.cmd("--follow", "metadata", "--format", "{{status}}{{title}}"),
                                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, encoding="utf-8", errors="replace",
                                               preexec_fn=die_with_parent)
                for _ in self._fproc.stdout:
                    self.wake.set()
            except Exception:
                pass
            finally:
                self._kill_follow()
            time.sleep(1.0)

    def run_worker(self):
        threading.Thread(target=self._follow, daemon=True).start()
        last_err = ""
        while True:
            try:
                self._worker_step()
            except Exception as e:  # a bad byte or a flaky player must never kill the loop
                msg = f"{type(e).__name__}: {e}"
                if msg != last_err:
                    print(f"lyricview: follow loop recovered from {msg}", file=sys.stderr)
                    last_err = msg
                time.sleep(1.0)

    def _auto_check(self):
        pass

    def _worker_step(self):
        self._auto_check()
        if self._mode != "follow":
            self.wake.wait(1.0)
            self.wake.clear()
            return
        last_meta, last_key = self._wk
        self.st.refresh()
        snap = self.st.snapshot()
        meta = {"active": snap["active"], "playing": snap["status"] == "Playing", "key": snap["key"], "title": snap["title"],
                "artist": snap["artist"], "album": snap["album"], "length": float(snap["length"] or 0)}
        if meta != last_meta:
            self._wk[0] = meta
            self._meta.emit(json.dumps(meta))
        key = snap["key"] if snap["active"] else None
        if key != last_key:
            self._wk[1] = key
            self._lyr.emit(json.dumps({"kind": "loading", "lines": []}))
            if key:
                with self.st.lock:
                    lev, aev = self.st.lyr_ev, self.st.art_ev
                threading.Thread(target=self._lyr_job, args=(key, lev), daemon=True).start()
                threading.Thread(target=self._art_job, args=(key, aev), daemon=True).start()
        self.sync.emit(float(snap["pos"]), meta["playing"])
        self.wake.wait(1.5)  # QML extrapolates between syncs; --follow wakes us instantly on any change
        self.wake.clear()

    def _lyr_job(self, key, ev):
        ev.wait(25)
        with self.st.lock:
            if self.st.key != key:
                return
            lyr = self.st.lyrics
        self._lyr.emit(json.dumps(lyr or {"kind": "none", "lines": [], "src": ""}, ensure_ascii=False))

    def _art_job(self, key, ev):
        ev.wait(15)
        with self.st.lock:
            if self.st.key != key:
                return
            art = self.st.art
        if art:
            try:
                info = process_art(art[0], key)
                if info:
                    self._art.emit(json.dumps(info))
            except Exception:
                pass

    # ---- slots called from QML
    def _ctl_then_sync(self, *args):
        self.st.ctl(*args)
        self.st.refresh()
        s = self.st.snapshot()
        self.sync.emit(float(s["pos"]), s["status"] == "Playing")

    def _follow_ctl(self, *args):
        threading.Thread(target=self._ctl_then_sync, args=args, daemon=True).start()

