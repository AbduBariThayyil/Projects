    # ---- start-up: pick the mode, build the library in the background
    def start(self):
        eng = None
        if os.environ.get("LYRICVIEW_ENGINE") == "null":
            eng = NullEngine()
        else:
            try:
                eng = QtEngine()
            except Exception as e:  # QtMultimedia missing
                self._engine_err = f"{type(e).__name__}: {e}"[:120]
        if eng:
            self.own = OwnPlayer(self, self.lib, eng, float(self._settings.get("volume", 0.8)), self._settings.get("mpris_name") or self.a.mpris_name or "lollypop")
        self.lib.load_cache()
        self.lib.apply_pending()
        self._scanning = True
        self.libChanged.emit()
        threading.Thread(target=self._scan, daemon=True).start()
        self._start_thumbs()
        threading.Thread(target=self.run_worker, daemon=True).start()
        a = self.a
        self._auto = not (a.player or a.follow or a.own)  # unless forced, we follow Lollypop (and co.) whenever one is running
        self.setMode("own", announce=False)
        self._rescan_timer = QTimer(self)
        self._rescan_timer.setInterval(30000)
        self._rescan_timer.timeout.connect(self._rescan)
        self._rescan_timer.start()

    def _scan(self):
        try:
            self.lib.scan()
        except Exception as e:
            print(f"lyricview: library scan failed: {e!r}", file=sys.stderr)
        self._libdone.emit()

    @Slot()
    def rescan(self):
        self._rescan(announce=True)

    def _rescan(self, announce=False):
        if self._scanning:
            return
        self._scanning = True
        if announce:
            self.toast.emit("rescanning your music…")
        threading.Thread(target=self._scan, daemon=True).start()

    def _on_libdone(self):
        changed = self.lib.pending is not None
        if changed:
            snap = self.own.snapshot() if self.own else None
            self.lib.apply_pending()
            if self.own:
                self.own.restore(snap)
            self._start_thumbs()
        self._scanning = False
        if changed:
            self.libChanged.emit()
        if self._mode == "own" and self.own and self.own.cur is None and self.lib.ready:
            self.own.activate()

    def setMode(self, m, announce=True):
        if m == "own":
            if not self.own:
                self.toast.emit("can't play audio here - install qt6-multimedia (" + (self._engine_err or "unavailable") + ")")
                return
            self._mode = "own"
            self._kill_follow()  # no helper process while we play our own music
            self.modeChanged.emit()
            if self.lib.ready:
                self.own.activate()
            if announce:
                self.toast.emit("your library · shuffling" if self.lib.ready else "scanning your music folder…")
        else:
            if self._mode == "own":  # remember what the screen showed, so coming back isn't a black screen
                self._own_ui = (dict(self._meta_d), self._kind, self._lyr_json, self._src, self._raw, self._length, dict(self._art_d))
            if self.own:
                self.own.deactivate()
            self._mode = "follow"
            self._wk = [None, None]
            self.modeChanged.emit()
            self.wake.set()
            if announce:
                ext = external_players()
                self.toast.emit(f"following {ext[0].split('.')[0]}" if ext else "following other players (none running)")

