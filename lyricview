def _num(s):
    m = re.match(r"\d+", str(s or ""))
    return int(m.group()) if m else 0


def external_players():
    """MPRIS players other than ourselves (Lollypop, mpv, ...), asked straight from D-Bus - no process spawned."""
    ignore = IGNORE[0] if IGNORE else None
    names = None
    try:
        import gi
