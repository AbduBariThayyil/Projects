# ───────────────────────────── network helpers ─────────────────────────────
def http_get(url, timeout=8, headers=None):
    req = urllib.request.Request(url, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def http_json(url, timeout=8, headers=None):
    return json.loads(http_get(url, timeout, headers).decode("utf-8"))


def itunes_lookup(query, country="US"):
    """Resolve a free-text query to canonical song metadata (title/artist/album/year/duration/art)."""
    try:
        url = "https://itunes.apple.com/search?" + urllib.parse.urlencode(
            {"term": query, "media": "music", "entity": "song", "limit": 8, "country": country})
        results = http_json(url, timeout=6).get("results", [])
    except Exception:
        return None
    qt = tokens(query)
    if not qt:
        return None
    best, best_s = None, 0.0
    for r in results:
        title, artist = r.get("trackName") or "", r.get("artistName") or ""
        hay = tokens(f"{artist} {title}")
        if not hay:
            continue
        s = len(qt & hay) / len(qt) - 0.15 * len(hay - qt) / len(hay) - variant_penalty(tokens(title), qt)
        if s > best_s:
            best, best_s = r, s
    if not best or best_s < 0.7:
        return None
    art = best.get("artworkUrl100")
    return Canon(
        title=best.get("trackName") or "",
        artist=best.get("artistName") or "",
        album=best.get("collectionName") or "",
        year=(best.get("releaseDate") or "")[:4],
        genre=best.get("primaryGenreName") or "",
        track=best.get("trackNumber") or 0,
        tracks=best.get("trackCount") or 0,
        disc=best.get("discNumber") or 0,
        duration=(best.get("trackTimeMillis") or 0) / 1000 or None,
        art=art.replace("100x100bb", "600x600bb") if art else None,
    )


def _squash(s):
    return norm(s).replace(" ", "")


def artist_ok(canon_artist, cand):
    """Is the uploader/artist of this candidate the catalogue artist? (Titles don't count: covers name the original artist.)"""
    if cand is None:
        return True
    names = list(cand.artists) or ([re.sub(r"\s*-\s*Topic$", "", cand.channel)] if cand.channel else [])
    names = [_squash(n) for n in names if _squash(n)]
    if not names:
        return True  # unknown -> don't punish
    for w in split_artists(canon_artist) or [canon_artist]:
        w = _squash(w)
        if w and any(w in n or (len(n) >= 4 and n in w) for n in names):
            return True
    return False


def canon_matches(canon, title, duration, cand=None):
    ct, xt = tokens(clean_title(canon.title)), tokens(clean_title(title))
    if not ct or len(ct & xt) / len(ct) < 0.6:
        return False
    if canon.duration and duration and abs(canon.duration - duration) > 6:
        return False
    return artist_ok(canon.artist, cand)


HAVE_YTM = importlib.util.find_spec("ytmusicapi") is not None
_ytm_err = {"msg": ""}
_ytm = None
_ytm_lock = threading.Lock()


def ytm_search(query, limit=8):
    """YouTube Music 'songs' search (official audio tracks) via ytmusicapi. None if unavailable."""
    global _ytm
    if not HAVE_YTM:
        return None
    try:
        with _ytm_lock:
            if _ytm is None:
                from ytmusicapi import YTMusic
                _ytm = YTMusic()
        res = _ytm.search(query, filter="songs", limit=limit)
    except Exception as e:
        _ytm_err["msg"] = f"{type(e).__name__}: {e}"[:140]
        return None
    out = []
    for r in res or []:
        vid = r.get("videoId")
        if not vid:
            continue
        thumbs = r.get("thumbnails") or []
        thumb = thumbs[-1]["url"] if thumbs else None
        out.append(Cand(
            vid=vid, title=r.get("title") or "",
            artists=[a["name"] for a in (r.get("artists") or []) if a.get("name")],
            album=(r.get("album") or {}).get("name"),
            duration=r.get("duration_seconds"), source="ytm",
            atv=r.get("videoType") == "MUSIC_VIDEO_TYPE_ATV", thumb=thumb,
        ))
    return out


_search_err = {"msg": ""}


def ytdlp_search(query, n=10):
    import yt_dlp
    opts = {"quiet": True, "no_warnings": True, "extract_flat": True, "skip_download": True,
            "logger": _QuietLog()}
