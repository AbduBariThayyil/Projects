@dataclass
class Canon:  # canonical metadata from the iTunes catalogue
    title: str
    artist: str
    album: str = ""
    year: str = ""
    genre: str = ""
    track: int = 0
    tracks: int = 0
    disc: int = 0
    duration: float | None = None
    art: str | None = None


@dataclass
class Cand:  # one downloadable candidate
    vid: str
    title: str
    artists: list = field(default_factory=list)
    album: str | None = None
    duration: float | None = None
    source: str = "yt"  # "ytm" (YouTube Music song result) | "yt" (plain YouTube)
    channel: str = ""
    atv: bool = False  # YT Music "official audio track"
    thumb: str | None = None
    url: str | None = None
    score: float = 0.0
    conf: float = 0.0

    @property
    def watch(self):
        return self.url or f"https://www.youtube.com/watch?v={self.vid}"

    @property
    def is_topic(self):
        return self.channel.endswith(" - Topic")

    def label(self):
        who = ", ".join(self.artists) or re.sub(r"\s*-\s*Topic$", "", self.channel) or "?"
        return f"{who} — {self.title}"

    def origin(self):
        if self.atv:
            return "YT Music · official audio track"
        if self.source == "ytm":
            return "YT Music · song result"
        if self.is_topic:
            return "YouTube · Topic channel (official audio)"
        return f"YouTube · {self.channel or 'unknown channel'}"


