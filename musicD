# ───────────────────────────── console / formatting ─────────────────────────────
class Console:
    """Thread-safe output with one live status line pinned to the bottom."""

    def __init__(self):
        self.tty = sys.stdout.isatty()
        self.color = self.tty and not os.environ.get("NO_COLOR")
        self.lock = threading.RLock()
        self._status = ""

    def paint(self, code, s):
        return f"\033[{code}m{s}\033[0m" if self.color else s

    def green(self, s): return self.paint("32", s)
    def yellow(self, s): return self.paint("33", s)
    def red(self, s): return self.paint("31", s)
    def dim(self, s): return self.paint("2", s)
    def bold(self, s): return self.paint("1", s)
    def cyan(self, s): return self.paint("36", s)

    def status(self, s):
        if not self.tty:
            return
        with self.lock:
            cols = shutil.get_terminal_size((100, 20)).columns - 1
            self._status = s[:cols]
            sys.stdout.write("\r\033[2K" + self._status)
            sys.stdout.flush()

    def log(self, msg=""):
        with self.lock:
            if self.tty:
                sys.stdout.write("\r\033[2K")
            print(msg)
            if self.tty and self._status:
                sys.stdout.write(self._status)
            sys.stdout.flush()


def fmt_time(s):
    if s is None:
        return "?:??"
    s = int(round(s))
    return f"{s // 60}:{s % 60:02d}"


def fmt_size(n):
    n = float(n or 0)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def bar(frac, width=22):
    n = int(round(width * max(0.0, min(1.0, frac))))
    return "━" * n + "─" * (width - n)


def short_path(p):
    p = str(p)
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


class Progress:
    """Overall progress for N tracks; each track reports a 0..1 fraction."""

    def __init__(self, con, total=1):
        self.con, self.total = con, total
        self.part, self.counts = {}, Counter()
        self.lock = threading.Lock()

    def update(self, key, frac, extra=""):
        with self.lock:
            self.part[key] = frac
            self._draw(extra)

    def finish(self, key, kind):
        with self.lock:
            self.part.pop(key, None)
            self.counts[kind] += 1
            self._draw()

    def _draw(self, extra=""):
        finished = sum(self.counts.values())
        frac = (finished + sum(self.part.values())) / max(self.total, 1)
        c = self.counts
        self.con.status(
            f"[{bar(frac)}] {int(frac * 100):>3}%  {finished}/{self.total}  "
            f"✔{c['done']} ⤼{c['skip']} ✘{c['fail']}  {extra}"
        )

    def clear(self):
        self.con.status("")


# ───────────────────────────── text helpers ─────────────────────────────
def norm(s):
    s = unicodedata.normalize("NFKD", s or "").lower()
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    return re.sub(r"[^\w\s]", " ", s)


def tokens(s):
    return set(norm(s).split())


_TITLE_NOISE = [
    re.compile(r"\s*[\(\[]\s*(?:official\s*(?:music\s*)?(?:video|audio|lyrics?|lyric\s*video|visuali[sz]er)?"
               r"|audio|lyrics?|lyric\s*video|4k|hd|remastered)\s*[\)\]]", re.I),
    re.compile(r"\s*-\s*official\s*(?:music\s*)?(?:video|audio)", re.I),
    re.compile(r"\s*\(video\)", re.I),
]


def clean_title(t):
    t = t or ""
    for rx in _TITLE_NOISE:
        t = rx.sub("", t)
    return t.strip()


_WHOLE_ARTISTS = {
    "tyler, the creator", "earth, wind & fire", "crosby, stills, nash & young",
    "hall & oates", "simon & garfunkel", "florence + the machine", "sofi tukker",
}


def split_artists(raw):
    raw = (raw or "").strip()
    if not raw:
        return []
    if raw.lower() in _WHOLE_ARTISTS:
        return [raw]
    parts = re.split(r"\s*(?:,|&|;|×|\bfeat\.?|\bft\.?|\bfeaturing\b)\s*", raw, flags=re.I)
    parts = [p.strip() for p in parts if p and p.strip()]
    return parts or [raw]


def clean_album(a):
    a = (a or "").strip()
    if not a or re.match(r"^(Mix|Playlist)\s*-", a, re.I):
        return "Singles"
    a = re.sub(r"^(?:Album|EP)\s*-\s*", "", a, flags=re.I).strip()
    if re.search(r"\s-\s*Single$", a, re.I):
        return "Singles"
    a = re.sub(r"\s-\s*EP$", "", a, flags=re.I).strip()
    return a or "Singles"


def safe(s, fallback="Unknown"):
    # '/' -> '_' keeps compatibility with the old script's library layout
    s = re.sub(r"[\x00-\x1f]", "", (s or "").replace("/", "_")).strip().rstrip(".")
    return s[:180] or fallback


BAD_TOKENS = {"live", "remix", "cover", "karaoke", "instrumental", "slowed", "reverb", "sped",
              "nightcore", "8d", "mashup", "tribute", "lofi", "boosted", "acoustic",
              "unplugged", "demo", "reprise"}


def bad_hits(toks, query_tokens=frozenset()):
    """Variant words (live/remix/cover...) in toks, also catching plurals like 'covers'/'remixes'."""
    q = set(query_tokens) | {t.rstrip("es").rstrip("s") for t in query_tokens}
    hits = {t for t in toks if t in BAD_TOKENS or t.rstrip("s") in BAD_TOKENS or t.rstrip("es") in BAD_TOKENS}
    return {t for t in hits if t not in q and t.rstrip("s") not in q}


def variant_penalty(title_tokens, query_tokens):
    return min(0.5, 0.25 * len(bad_hits(title_tokens, query_tokens)))


