#!/usr/bin/env bash
# ani-cast: Search & cast anime to TV or local device with resume, season auto-advance & downloads
export ANI_CLI_PLAYER="mpv-chromecast"
export ANI_CLI_MENU="ani-cast-menu"

ENGINE_PY="/home/vibecoder/Projects/ani-cast/lib/anicast_engine.py"

unset ANI_CAST_START_TIME
unset ANI_CAST_NO_SUB
unset ANI_CAST_DEVICE
unset ANI_CAST_LOCAL
unset ANI_CAST_DOWNLOAD

# Reset session state files on every new command launch so initial device prompt always appears
rm -f "${XDG_RUNTIME_DIR:-/tmp}/ani_cast_session_device" 2>/dev/null || true
rm -f "${XDG_RUNTIME_DIR:-/tmp}/ani_cast_first_ep_done" 2>/dev/null || true
rm -f "${XDG_RUNTIME_DIR:-/tmp}/ani_cast_action" 2>/dev/null || true
rm -f "${XDG_RUNTIME_DIR:-/tmp}/ani_cast_next_season_pending" 2>/dev/null || true
rm -f "$HOME/.local/state/ani-cast/last_device.txt" 2>/dev/null || true

CONTINUE_MODE=0
CONTINUE_QUERY=""
DOWNLOAD_MODE=0
LOCAL_MODE=0
QUALITY="1080p"
SEASON=""
EPISODE=""
DUB_FLAG=0
POSITIONAL_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            cat << 'EOF'
ani-cast - Smart Anime Casting & Streaming CLI

Usage:
  ani-cast [options] [query]
  ani-cast --continue [query]
  ani-cast --local [query]
  ani-cast --download [query]

Options:
  -c, --continue [query]  Pick up on the last watched season, episode & exact timestamp
  -l, --local             Play locally on this computer screen via MPV (no Chromecast required)
  -d, --download [query]  Download entire season (smartly skips episodes you already completed)
  -s, --season <number>   Select specific season (1, 2, 3...)
  -e, --episode <number>  Specify episode number or range (e.g. 1 or 1-12)
  -q, --quality <quality> Video quality (1080p, 720p, 360p, best)
  --dub                   Play English dubbed version
  -ns, --no-sub           Disable subtitles
  -t, --device <name|ip>  Select target device (e.g. -t local, -t "DUAA TV", -t 192.168.1.4)
  -ss, --time <seconds>   Seek to specific timestamp at start (e.g. -ss 120 or -ss 04:30)
  -g, --gui               Launch native GTK 4 AniCast application

Examples:
  ani-cast -c                   # Resume the most recently watched anime right where you left off
  ani-cast -c "blue lock"       # Resume Blue Lock on its latest season, episode & timestamp
  ani-cast -l "naruto"          # Watch Naruto locally on your computer screen
  ani-cast -d "blue lock" -s 2  # Download Season 2 of Blue Lock (skipping completed episodes)
EOF
            exit 0
            ;;
        -g|--gui)
            if [ -x ~/.local/bin/ani-cast-gui ]; then
                exec ~/.local/bin/ani-cast-gui
            elif [ -x /home/vibecoder/Projects/ani-cast/gui/ani-cast-gui ]; then
                exec /home/vibecoder/Projects/ani-cast/gui/ani-cast-gui
            elif [ -x /home/vibecoder/Projects/ani-cast-gui/ani-cast-gui ]; then
                exec /home/vibecoder/Projects/ani-cast-gui/ani-cast-gui
            else
                echo "AniCast GUI is currently rebuilding. Launching CLI mode..."
            fi
            ;;
        -c|--continue)
            CONTINUE_MODE=1
            if [ $# -ge 2 ] && [[ "$2" != -* ]]; then
                CONTINUE_QUERY="$2"
                shift 2
            else
                shift
            fi
            ;;
        -l|--local)
            LOCAL_MODE=1
            export ANI_CAST_LOCAL=1
            export ANI_CAST_DEVICE="local"
            shift
            ;;
        -d|--download)
            DOWNLOAD_MODE=1
            export ANI_CAST_DOWNLOAD=1
            shift
            ;;
        -d)
            # Check if this is download or dub
            DOWNLOAD_MODE=1
            export ANI_CAST_DOWNLOAD=1
            shift
            ;;
        --dub)
            DUB_FLAG=1
            shift
            ;;
        -ns|--no-sub|--no-subs)
            export ANI_CAST_NO_SUB=1
            shift
            ;;
        -s|--season)
            if [ $# -ge 2 ]; then
                SEASON="$2"
                shift 2
            else
                shift
            fi
            ;;
        -s=*|--season=*)
            SEASON="${1#*=}"
            shift
            ;;
        -e|--episode|-r|--range)
            if [ $# -ge 2 ]; then
                EPISODE="$2"
                shift 2
            else
                shift
            fi
            ;;
        -e=*|--episode=*|-r=*|--range=*)
            EPISODE="${1#*=}"
            shift
            ;;
        -ss|--time|--start|--seek)
            if [ $# -ge 2 ]; then
                export ANI_CAST_START_TIME="$2"
                shift 2
            else
                shift
            fi
            ;;
        -ss=*|--time=*|--start=*|--seek=*)
            export ANI_CAST_START_TIME="${1#*=}"
            shift
            ;;
        --device|-t)
            if [ $# -ge 2 ]; then
                export ANI_CAST_DEVICE="$2"
                if [ "$2" = "local" ] || [ "$2" = "0" ] || [ "$2" = "this" ]; then
                    LOCAL_MODE=1
                    export ANI_CAST_LOCAL=1
                fi
                shift 2
            else
                shift
            fi
            ;;
        --device=*|-t=*)
            VAL="${1#*=}"
            export ANI_CAST_DEVICE="$VAL"
            if [ "$VAL" = "local" ] || [ "$VAL" = "0" ] || [ "$VAL" = "this" ]; then
                LOCAL_MODE=1
                export ANI_CAST_LOCAL=1
            fi
            shift
            ;;
        -q|--quality)
            if [ $# -ge 2 ]; then
                QUALITY="${2%p}"
                export ANI_CAST_QUALITY="${QUALITY}p"
                shift 2
            else
                shift
            fi
            ;;
        -q=*|--quality=*)
            QUALITY="${1#*=}"
            QUALITY="${QUALITY%p}"
            export ANI_CAST_QUALITY="${QUALITY}p"
            shift
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

QUERY="${POSITIONAL_ARGS[*]}"

# Handle --continue flag
if [ "$CONTINUE_MODE" = "1" ]; then
    TARGET_JSON=$(python3 "$ENGINE_PY" continue "${CONTINUE_QUERY:-$QUERY}")
    if [ -z "$TARGET_JSON" ]; then
        echo -e "\033[1;31m[!] No matching watch history found to continue.\033[0m"
        exit 1
    fi

    SEARCH_TITLE=$(echo "$TARGET_JSON" | jq -r '.search_title // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('search_title',''))" <<< "$TARGET_JSON")
    EP_NUM=$(echo "$TARGET_JSON" | jq -r '.episode // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('episode',''))" <<< "$TARGET_JSON")
    START_TS=$(echo "$TARGET_JSON" | jq -r '.timestamp // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('timestamp',''))" <<< "$TARGET_JSON")
    TIME_STR=$(echo "$TARGET_JSON" | jq -r '.time_str // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('time_str',''))" <<< "$TARGET_JSON")
    WAS_COMPL=$(echo "$TARGET_JSON" | jq -r '.was_completed // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('was_completed',''))" <<< "$TARGET_JSON")
    SEASON_NUM=$(echo "$TARGET_JSON" | jq -r '.season // empty' 2>/dev/null || python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('season',''))" <<< "$TARGET_JSON")

    if [ "$WAS_COMPL" = "true" ] || [ "$WAS_COMPL" = "True" ]; then
        echo -e "\033[1;32m==>\033[0m Advancing to next episode: \033[1;36m${SEARCH_TITLE} Episode ${EP_NUM}\033[0m..."
    else
        echo -e "\033[1;32m==>\033[0m Resuming \033[1;36m${SEARCH_TITLE} Episode ${EP_NUM}\033[0m from \033[1;33m${TIME_STR}\033[0m..."
    fi

    QUERY="$SEARCH_TITLE"
    EPISODE="$EP_NUM"
    [ -n "$SEASON_NUM" ] && SEASON="$SEASON_NUM"
    export ANI_CAST_START_TIME="$START_TS"
fi

# Handle --download mode
if [ "$DOWNLOAD_MODE" = "1" ]; then
    if [ -z "$QUERY" ]; then
        echo -n -e "\033[1;36mEnter anime name to download: \033[0m"
        read -r QUERY || exit 1
    fi
    exec python3 "$ENGINE_PY" download "$QUERY" "${SEASON:-1}"
fi

# Outer Season Transition Loop
CURRENT_QUERY="$QUERY"
CURRENT_SEASON="${SEASON:-1}"

while true; do
    CLI_ARGS=()

    [ -n "$QUALITY" ] && CLI_ARGS+=("-q" "$QUALITY")
    [ "$DUB_FLAG" = "1" ] && CLI_ARGS+=("--dub")

    # If season was specified or determined (>1), ensure title includes season name if not already present
    if [ -n "$CURRENT_SEASON" ] && [ "$CURRENT_SEASON" -gt 1 ] 2>/dev/null; then
        if [[ ! "${CURRENT_QUERY,,}" =~ season[[:space:]]*[0-9]+ ]]; then
            CURRENT_QUERY="$CURRENT_QUERY Season $CURRENT_SEASON"
        fi
    fi

    if [ -n "$EPISODE" ]; then
        CLI_ARGS+=("-e" "$EPISODE")
        # Clear episode for subsequent seasons
        unset EPISODE
    fi

    [ -n "$CURRENT_QUERY" ] && CLI_ARGS+=("$CURRENT_QUERY")

    # Run ani-cli
    ani-cli --no-detach "${CLI_ARGS[@]}"
    CLI_STATUS=$?

    # Check if Season Advance was triggered by ani-cast-menu or season finale completion
    NEXT_FLAG="${XDG_RUNTIME_DIR:-/tmp}/ani_cast_next_season_pending"
    if [ -f "$NEXT_FLAG" ]; then
        rm -f "$NEXT_FLAG" 2>/dev/null || true

        # Find next season info
        NEXT_JSON=$(python3 "$ENGINE_PY" next-season "${CURRENT_QUERY:-$SEARCH_TITLE}" "$CURRENT_SEASON" 2>/dev/null || true)
        if [ -n "$NEXT_JSON" ]; then
            NEXT_TITLE=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('search_title',''))" <<< "$NEXT_JSON" 2>/dev/null || true)
            NEXT_S=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('season',''))" <<< "$NEXT_JSON" 2>/dev/null || true)
            if [ -n "$NEXT_TITLE" ]; then
                echo -e "\n\033[1;32m==> Advancing to Next Season: \033[1;36m${NEXT_TITLE} Episode 1\033[0m!\n"
                CURRENT_QUERY="$NEXT_TITLE"
                CURRENT_SEASON="${NEXT_S:-$((CURRENT_SEASON + 1))}"
                EPISODE="1"
                unset ANI_CAST_START_TIME
                sleep 1
                continue
            fi
        fi
        echo -e "\n\033[1;33m[!] You have reached the latest released season of the series!\033[0m"
        break
    else
        break
    fi
done
